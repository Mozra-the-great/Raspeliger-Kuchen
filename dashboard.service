[Unit]
Description=Raumverwaltung Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=raspi
WorkingDirectory=/home/raspi/dashboard_mariadb
ExecStart=/usr/bin/python3 /home/raspi/dashboard_mariadb/app.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target



